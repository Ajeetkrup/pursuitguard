# Switch LLM_PROVIDER to `gemini` (Gemini Developer API) or `vertex_gemini` (Vertex AI) for live calls
LLM_PROVIDER=mock

# --- Option A: Gemini Developer API (Default live config via `genai.Client(api_key=...)`) ---
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_LIGHT_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false

# --- Option B: Optional Google Cloud Vertex AI (Express Mode or Project-Bound / ADC) ---
# Set LLM_PROVIDER=vertex_gemini (or GOOGLE_GENAI_USE_VERTEXAI=true), and provide either
# GOOGLE_API_KEY (Express/Standard) or `gcloud auth application-default login` + GOOGLE_CLOUD_PROJECT.
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_EMBED_MODEL=gemini-embedding-2

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CRM_DB_PATH=data/crm.db
CHECKPOINT_DB_PATH=data/checkpoints.db
STALE_CRM_DAYS=7
MAX_TOOL_CALLS=12
MAX_TOKEN_BUDGET=25000
MAX_RETRIES=1
LOG_LEVEL=INFO
